{
  "schemaVersion": 1,
  "id": "retrochat",
  "version": "${version}",
  "name": "RetroChat",
  "description": "Retro 2010s Facebook-style instant direct messaging UI for Minecraft.\n\nAuthor: tikhi\nDiscord: .tikhi\nGitHub: tikh1",
  "authors": [
    "tikhi"
  ],
  "contact": {
    "homepage": "https://github.com/tikh1/RetroChat",
    "sources": "https://github.com/tikh1/RetroChat",
    "issues": "https://github.com/tikh1/RetroChat/issues"
  },
  "license": "MIT",
  "icon": "assets/retrochat/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.sen.modid.RetroChatClient"
    ],
    "modmenu": [
      "com.sen.modid.ui.RetroChatModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.0",
    "minecraft": ">=26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
