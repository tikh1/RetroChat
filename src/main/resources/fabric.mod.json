{
  "schemaVersion": 1,
  "id": "retrochat",
  "version": "${version}",
  "name": "RetroChat",
  "description": "Retro 2010s Facebook-style instant direct messaging UI for Minecraft.",
  "authors": [
    "Sen"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/retrochat/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.sen.modid.RetroChatClient"
    ],
    "modmenu": [
      "com.sen.modid.ui.RetroChatModMenu"
    ]
  },
  "mixins": [
    "retrochat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
